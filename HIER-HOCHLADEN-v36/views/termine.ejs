<%- include('partials/kopf') %>
<div class="seitenkopf">
  <div><h1>Termine</h1>
    <div class="unter"><%= termine.length %> Termin(e)<%= filter ? ' · gefiltert' : '' %></div></div>
</div>

<!-- Filter in einer Zeile, immer an derselben Stelle -->
<form method="get" action="/termine" class="filterleiste nicht-drucken">
  <div class="feld"><label>Zeigen</label>
    <select name="f" onchange="this.form.submit()">
      <option value="" <%= filter === '' ? 'selected' : '' %>>alle</option>
      <option value="offen" <%= filter === 'offen' ? 'selected' : '' %>>ausstehend</option>
      <option value="heute" <%= filter === 'heute' ? 'selected' : '' %>>heute</option>
      <option value="spaet" <%= filter === 'spaet' ? 'selected' : '' %>>nachzufassen</option>
      <option value="fertig" <%= filter === 'fertig' ? 'selected' : '' %>>durchgeführt</option>
    </select></div>
  <div class="rand">
    <span class="ampel ampel-offen">geplant</span>
    <span class="ampel ampel-jetzt">heute</span>
    <span class="ampel ampel-spaet">nachfassen</span>
    <span class="ampel ampel-gut">durchgeführt</span>
  </div>
</form>

<div class="kasten" style="margin-bottom:18px">
  <b>Die Ampel sagt, was ansteht.</b> „nachfassen" heißt: Der Termin ist vorbei und niemand hat
  vermerkt, ob er stattgefunden hat. Ob ein vergangener Termin gelaufen oder ausgefallen ist,
  kann die Anwendung nicht wissen — das trägt ein Mensch ein, über <i>bearbeiten → Status</i>.
  <br><br>
  <b>Kalender</b> lädt eine Datei — beim Öffnen trägt Outlook den Termin ein.
  <b>Einladung</b> erzeugt dieselbe Datei als Terminanfrage an den Kunden.
  <b>Mail</b> öffnet Outlook mit fertigem Text.
  <% if (m365Verbunden) { %><br><b>In Outlook</b> schreibt unmittelbar in Ihren Kalender.<% } %>
</div>

<div class="karte">
  <% if (!termine.length) { %><div class="leer-hinweis">Keine Termine in dieser Auswahl.</div><% } else { %>
  <div class="tab-scroll"><table>
    <thead><tr><th>Stand</th><th>Datum</th><th>Kunde</th><th>Projekt</th><th>Typ</th>
      <th>Mit wem</th><th>Thema</th><th>Bestätigt</th><th></th></tr></thead>
    <tbody><% termine.forEach(function(t){ var a = terminAmpel(t); %>
      <tr class="<%= a.stufe === 'durchgefuehrt' ? 'erledigt' : (a.stufe === 'abgesagt' ? 'abgesagt' : (a.stufe === 'ueberfaellig' ? 'spaet' : '')) %>">
        <td><span class="ampel <%= a.klasse %>"><%= a.wort %></span>
          <% if (t.durchgefuehrt_am) { %><br><span style="font-size:11px;color:var(--ink3)"><%= datum(t.durchgefuehrt_am) %></span><% } %></td>
        <td style="white-space:nowrap"><%= datum(t.datum) %>
          <% if (t.uhrzeit) { %><br><span style="font-size:12px;color:var(--ink3)"><%= t.uhrzeit %></span><% } %></td>
        <td><a href="/kunden/<%= t.kunde_id %>"><%= t.firma %></a></td>
        <td><% if (t.projekt_id) { %><a href="/projekte/<%= t.projekt_id %>"><%= t.bezeichnung || 'Projekt' %></a><% } else { %>—<% } %></td>
        <td><span class="pille"><%= t.typ %></span></td>
        <td><%= t.mit_wem || '—' %></td>
        <td><%= t.thema || '—' %><% if (t.ergebnis) { %><br><span style="font-size:12px;color:var(--ink3)"><%= t.ergebnis %></span><% } %></td>
        <td><span class="pille <%= t.bestaetigt === 'ja' ? 'ok' : t.bestaetigt === 'nein' ? 'rot' : '' %>"><%= t.bestaetigt %></span></td>
        <td class="z">
          <div class="reihe" style="gap:5px;justify-content:flex-end;margin-bottom:5px">
            <% if (t.datum) { %>
              <a class="knopf leer mini" href="/termine/<%= t.id %>/kalender.ics" title="Kalenderdatei">Kalender</a>
              <% if (t.kunde_email) { %>
                <a class="knopf leer mini" href="/termine/<%= t.id %>/kalender.ics?einladung=1" title="Als Terminanfrage">Einladung</a>
              <% } %>
            <% } %>
            <% if (m365Verbunden && t.datum) { %>
              <form method="post" action="/m365/termin/<%= t.id %>" style="display:inline">
                <button class="knopf mini" type="submit"><%= t.m365_ereignis_id ? 'Outlook ↻' : 'In Outlook' %></button></form>
            <% } %>
            <% if (t.mailto) { %><a class="knopf leer mini" href="<%= t.mailto %>">Mail</a><% } %>
          </div>

          <details class="block" style="margin:0;border:none;background:none">
            <summary style="padding:4px 0">bearbeiten</summary>
            <div class="inhalt" style="padding:10px 0 0;min-width:300px;text-align:left">
              <form method="post" action="/termine/<%= t.id %>">
                <div class="felder2">
                  <div class="feld"><label>Datum</label>
                    <input type="date" name="datum" value="<%= fuerFeld(t.datum) %>"></div>
                  <div class="feld"><label>Uhrzeit</label>
                    <input type="text" name="uhrzeit" value="<%= t.uhrzeit || '' %>" placeholder="z. B. 14:00 oder 14:00-16:30"></div>
                </div>
                <div class="felder2">
                  <div class="feld"><label>Status</label><select name="status">
                    <% ['geplant','durchgeführt','verschoben','abgesagt'].forEach(function(s){ %>
                      <option <%= t.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
                  <div class="feld"><label>Bestätigt</label><select name="bestaetigt">
                    <% ['offen','ja','nein'].forEach(function(s){ %>
                      <option <%= t.bestaetigt === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
                </div>
                <div class="felder2">
                  <div class="feld"><label>Art</label><select name="typ">
                    <% ['Kunde','Begehung','Elektriker','Tiefbau','Sonstiges'].forEach(function(s){ %>
                      <option <%= t.typ === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
                  <div class="feld"><label>Mit wem</label>
                    <input type="text" name="mit_wem" value="<%= t.mit_wem || '' %>"></div>
                </div>
                <div class="feld"><label>Ort</label><input type="text" name="ort" value="<%= t.ort || '' %>"></div>
                <div class="feld"><label>Thema</label><input type="text" name="thema" value="<%= t.thema || '' %>"></div>
                <div class="feld"><label>Ergebnis</label>
                  <textarea name="ergebnis" style="min-height:60px"><%= t.ergebnis || '' %></textarea></div>
                <div class="haken"><input type="checkbox" id="ki<%= t.id %>" name="kunde_informiert" <%= t.kunde_informiert ? 'checked' : '' %>>
                  <label for="ki<%= t.id %>">Kunde informiert</label></div>
                <div class="feld"><label>Wie informiert</label><select name="kunde_informiert_methode">
                  <option value="">—</option>
                  <% ['Telefon','E-Mail','Persönlich','Sonstiges'].forEach(function(s){ %>
                    <option <%= t.kunde_informiert_methode === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
                <button class="knopf mini" type="submit">Speichern</button>
              </form>

              <form method="post" action="/termine/<%= t.id %>/loeschen" style="margin-top:10px"
                    onsubmit="return confirm('Diesen Termin löschen? Der Vorgang bleibt in der Kundenhistorie vermerkt.')">
                <button class="knopf gefahr leer mini" type="submit">Termin löschen</button>
              </form>
            </div>
          </details>
        </td>
      </tr>
    <% }) %></tbody></table></div>
  <% } %>
</div>
<%- include('partials/fuss') %>
