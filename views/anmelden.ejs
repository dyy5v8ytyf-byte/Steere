<!DOCTYPE html>
<html lang="de" data-modus="<%= modus %>">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Anmelden · STEER.E</title><meta name="robots" content="noindex, nofollow">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/public/steere.css">
</head>
<body>
<div class="anmelde-seite">
  <div class="anmelde-karte">
    <svg width="42" height="42" viewBox="0 0 100 100" style="margin-bottom:14px">
      <circle cx="50" cy="50" r="47" fill="none" stroke="var(--brass)" stroke-width="2"/>
      <polygon points="50,9 56.5,50 50,43.5 43.5,50" fill="var(--brass)"/>
      <polygon points="50,91 43.5,50 50,56.5 56.5,50" fill="currentColor" opacity=".85"/>
      <polygon points="9,50 50,43.5 43.5,50 50,56.5" fill="currentColor" opacity=".4"/>
      <polygon points="91,50 50,56.5 56.5,50 50,43.5" fill="currentColor" opacity=".4"/>
      <circle cx="50" cy="50" r="3.6" fill="var(--bg)" stroke="var(--brass)" stroke-width="2.4"/>
    </svg>
    <div class="wm">STEER<i>.</i>E</div>
    <div class="sub">Ein Produkt der Westphal Wavetec</div>

    <% if (fehler) { %><div class="melde fehler"><%= fehler %></div><% } %>

    <form method="post" action="/anmelden">
      <input type="hidden" name="weiter" value="<%= weiter %>">
      <div class="feld">
        <label for="email">E-Mail</label>
        <input type="email" id="email" name="email" required autofocus autocomplete="username">
      </div>
      <div class="feld">
        <label for="passwort">Passwort</label>
        <input type="password" id="passwort" name="passwort" required autocomplete="current-password">
      </div>
      <button class="knopf" style="width:100%" type="submit">Anmelden</button>
    </form>
    <p style="margin-top:20px;font-size:12px;color:var(--ink3);line-height:1.5">
      Zugang vergessen oder gesperrt? Die Administration kann das Passwort zurücksetzen.
    </p>
  </div>
</div>
</body>
</html>
