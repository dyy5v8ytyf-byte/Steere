<%- include('partials/head', { title: 'Neuer Kunde' }) %>

<h1>Neuer Kunde</h1>

<form method="post" action="/kunden" class="card">
  <div class="grid-form">
    <div><label>Firma *</label><input type="text" name="firma" required></div>
    <div><label>Branche</label><input type="text" name="branche"></div>
    <div><label>Adresse</label><input type="text" name="adresse"></div>
    <div><label>Website</label><input type="text" name="website"></div>
    <div><label>Lead-Quelle</label><input type="text" name="quelle" placeholder="z.B. Messe, LinkedIn, Empfehlung"></div>
    <div><label>Ansprechpartner Name</label><input type="text" name="ap1_name"></div>
    <div><label>Ansprechpartner Kontakt (Tel/E-Mail)</label><input type="text" name="ap1_kontakt"></div>
    <div>
      <label>Projektmanager</label>
      <select name="projektmanager_id">
        <option value="">– noch offen –</option>
        <% employees.forEach(function(e) { %><option value="<%= e.id %>"><%= e.name %> (<%= e.role %>)</option><% }) %>
      </select>
    </div>
  </div>
  <div style="margin-top:10px;">
    <label>Projektbeschreibung (mögliches Projekt)</label>
    <textarea name="projekt_beschreibung" rows="3" style="width:100%;"></textarea>
  </div>
  <p class="muted">Startet automatisch in Phase "Terminanfrage".</p>
  <button type="submit">Anlegen</button>
</form>

<%- include('partials/foot') %>
