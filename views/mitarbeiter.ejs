<%- include('partials/kopf') %>
<div class="seitenkopf"><div><h1>Mitarbeiter</h1><div class="unter">Zuordnung von Aufgaben und Projekten. Ein Login wird hierdurch nicht angelegt.</div></div></div>
<div class="spalten s21">
  <div class="karte">
    <div class="tab-scroll"><table>
      <thead><tr><th>Name</th><th>Rolle</th><th>E-Mail</th><th>Aktiv</th><th></th></tr></thead>
      <tbody><% liste.forEach(function(m){ %>
        <tr><td colspan="5" style="padding:0">
          <form method="post" action="/mitarbeiter" style="display:grid;grid-template-columns:1.4fr 1fr 1.4fr auto auto;gap:8px;align-items:center;padding:8px 0">
            <input type="hidden" name="id" value="<%= m.id %>">
            <input type="text" name="name" value="<%= m.name %>">
            <select name="rolle"><% rollen.forEach(function(r){ %><option <%= m.rolle === r ? 'selected' : '' %>><%= r %></option><% }) %><% if (!rollen.includes(m.rolle)) { %><option selected><%= m.rolle %></option><% } %></select>
            <input type="text" name="email" value="<%= m.email || '' %>">
            <label style="margin:0;display:flex;gap:6px;align-items:center;text-transform:none;letter-spacing:0"><input type="checkbox" name="aktiv" <%= m.aktiv ? 'checked' : '' %> style="width:16px;height:16px;accent-color:var(--brass)"> aktiv</label>
            <button class="knopf leer mini" type="submit">Speichern</button>
          </form>
        </td></tr>
      <% }) %></tbody></table></div>
  </div>
  <div class="karte">
    <h2>Neu anlegen</h2><div class="marke-strich"></div>
    <form method="post" action="/mitarbeiter">
      <div class="feld"><label>Name</label><input type="text" name="name" required></div>
      <div class="feld"><label>Rolle</label><select name="rolle"><% rollen.forEach(function(r){ %><option><%= r %></option><% }) %></select></div>
      <div class="feld"><label>E-Mail</label><input type="text" name="email"></div>
      <button class="knopf" type="submit">Anlegen</button>
    </form>
  </div>
</div>
<%- include('partials/fuss') %>
