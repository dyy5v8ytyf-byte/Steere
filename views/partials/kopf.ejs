<!DOCTYPE html>
<html lang="de" data-modus="<%= modus %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= titel %> · STEER.E</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/public/steere.css">
</head>
<body>
<% if (typeof benutzer !== 'undefined' && benutzer) { %>
<header class="kopf">
  <div class="innen">
    <a class="marke" href="/">
      <svg width="32" height="32" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="47" fill="none" stroke="var(--brass)" stroke-width="2"/>
        <polygon points="50,9 56.5,50 50,43.5 43.5,50" fill="var(--brass)"/>
        <polygon points="50,91 43.5,50 50,56.5 56.5,50" fill="currentColor" opacity=".85"/>
        <polygon points="9,50 50,43.5 43.5,50 50,56.5" fill="currentColor" opacity=".4"/>
        <polygon points="91,50 50,56.5 56.5,50 50,43.5" fill="currentColor" opacity=".4"/>
        <circle cx="50" cy="50" r="3.6" fill="var(--bg)" stroke="var(--brass)" stroke-width="2.4"/>
      </svg>
      <div>
        <div class="wm">STEER<i>.</i>E</div>
        <div class="sub">Westphal Wavetec</div>
      </div>
    </a>

    <nav class="menue">
      <% if (benutzer.rolle !== 'partner') { %>
        <a href="/"          class="<%= pfad === '/' ? 'an' : '' %>">Übersicht</a>
        <a href="/kunden"    class="<%= pfad.startsWith('/kunden') ? 'an' : '' %>">Kunden</a>
        <a href="/begehungen" class="<%= pfad.startsWith('/begehungen') ? 'an' : '' %>">Begehungen</a>
        <a href="/angebote"  class="<%= pfad.startsWith('/angebote') ? 'an' : '' %>">Angebote</a>
        <a href="/rechnungen" class="<%= pfad.startsWith('/rechnungen') ? 'an' : '' %>">Rechnungen</a>
        <a href="/finanzen"  class="<%= pfad.startsWith('/finanzen') ? 'an' : '' %>">Finanzen</a>
        <a href="/forecast"  class="<%= pfad.startsWith('/forecast') ? 'an' : '' %>">Forecast</a>
        <a href="/kalkulator" class="<%= pfad.startsWith('/kalkulator') ? 'an' : '' %>">Kalkulator</a>
        <a href="/preise"    class="<%= pfad.startsWith('/preise') ? 'an' : '' %>">Preise</a>
        <a href="/vorlagen"  class="<%= pfad.startsWith('/vorlagen') ? 'an' : '' %>">Vorlagen</a>
        <a href="/termine"   class="<%= pfad.startsWith('/termine') ? 'an' : '' %>">Termine</a>
        <a href="/aufgaben"  class="<%= pfad.startsWith('/aufgaben') ? 'an' : '' %>">Aufgaben</a>
        <a href="/partner"   class="<%= pfad.startsWith('/partner') ? 'an' : '' %>">Partner</a>
        <% if (benutzer.rolle === 'admin') { %>
          <a href="/verwaltung" class="<%= pfad.startsWith('/verwaltung') ? 'an' : '' %>">Verwaltung</a>
        <% } %>
      <% } else { %>
        <a href="/partner" class="<%= pfad === '/partner' ? 'an' : '' %>">Meine Projekte</a>
        <a href="/partner/nachweis" class="<%= pfad.startsWith('/partner/nachweis') ? 'an' : '' %>">Monatsnachweis</a>
      <% } %>
    </nav>

    <div class="rechts">
      <div class="wer">
        <b><%= benutzer.name %></b>
        <%= benutzer.rolle === 'admin' ? 'Administration' : benutzer.rolle === 'partner' ? (benutzer.org_name || 'Partner') : 'Team' %>
      </div>
      <a class="knopf-klein" href="/modus/<%= modus === 'dunkel' ? 'hell' : 'dunkel' %>" title="Hell- / Dunkelmodus"><%= modus === 'dunkel' ? 'Hell' : 'Dunkel' %></a>
      <a class="knopf-klein" href="/passwort">Passwort</a>
      <a class="knopf-klein" href="/abmelden">Abmelden</a>
    </div>
  </div>
</header>
<% } %>
<main>
<% if (typeof hinweis !== 'undefined' && hinweis) { %>
  <div class="melde <%= hinweis.art === 'warn' ? 'warn' : hinweis.art === 'fehler' ? 'fehler' : '' %>"><%= hinweis.text %></div>
<% } %>
