<!DOCTYPE html>
<html lang="de"><head><meta charset="UTF-8"><title>Monatsnachweis <%= monat %> · <%= org.name %></title>
<style>
  @page{size:A4;margin:16mm}
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:Arial,Helvetica,sans-serif;color:#111;font-size:10pt;line-height:1.45;background:#fff}
  .blatt{max-width:186mm;margin:0 auto;padding:14px}
  .kopf{background:#0A1628;color:#F2EEE6;padding:16px 18px;margin-bottom:20px}
  .marke{font-family:Georgia,serif;font-size:14pt;font-weight:bold}
  .marke i{font-style:normal;color:#C89B4A}
  .kopf .t{font-size:8pt;letter-spacing:1.8px;text-transform:uppercase;color:#A9BACE;margin-top:3px}
  .kopf h1{font-family:Georgia,serif;font-size:14pt;margin-top:12px}
  .meta{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#ddd;border:1px solid #ddd;margin-bottom:18px}
  .meta > div{background:#fff;padding:9px 11px}
  .meta dt{font-size:7.5pt;letter-spacing:.9px;text-transform:uppercase;color:#666;margin-bottom:3px}
  .meta dd{font-weight:bold;font-size:10pt;color:#0A1628}
  .parteien{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;font-size:9pt}
  .parteien > div{border:1px solid #ddd;padding:11px 13px}
  .parteien .k{font-size:7.5pt;letter-spacing:.9px;text-transform:uppercase;color:#666;margin-bottom:5px}
  table{width:100%;border-collapse:collapse;font-size:9pt;margin-bottom:16px}
  th{text-align:left;font-size:7.5pt;letter-spacing:.8px;text-transform:uppercase;color:#555;border-bottom:1pt solid #888;padding:0 6px 5px 0;font-weight:bold}
  td{padding:8px 6px 8px 0;border-bottom:.5pt solid #ddd;vertical-align:top}
  td.z,th.z{text-align:right;white-space:nowrap}
  tr.summe td{border-top:1.2pt solid #0A1628;border-bottom:none;font-weight:bold;color:#0A1628;padding-top:9px}
  h2{font-family:Georgia,serif;font-size:11pt;margin:20px 0 9px;color:#0A1628}
  .rechnung{width:96mm;margin-left:auto;border:1px solid #ddd}
  .rechnung div{display:flex;justify-content:space-between;padding:7px 12px;border-bottom:.5pt solid #eee;font-size:9pt}
  .rechnung div:last-child{border-bottom:none}
  .rechnung div.gesamt{background:#f4f1ea;font-weight:bold;color:#0A1628}
  .hinw{font-size:8pt;color:#555;margin-top:12px;line-height:1.5;font-style:italic}
  .unterschrift{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:34px;font-size:9pt}
  .unterschrift div{border-top:.6pt solid #666;padding-top:6px}
  .drucken{margin-bottom:14px}
  @media print{.drucken{display:none}.blatt{padding:0}}
</style></head>
<body><div class="blatt">
  <div class="drucken"><button onclick="window.print()" style="padding:9px 18px;border:1px solid #C89B4A;background:#C89B4A;color:#0A1628;font-weight:bold;cursor:pointer;border-radius:3px">Drucken / als PDF sichern</button></div>

  <div class="kopf">
    <div class="marke">STEER<i>.</i>E</div>
    <div class="t">PMaaS · Ladeinfrastruktur</div>
    <h1>Monatsbericht · Leistungsnachweis Retainer</h1>
  </div>

  <div class="meta">
    <div><dt>Berichtszeitraum</dt><dd><%= monat %></dd></div>
    <div><dt>Kontingent</dt><dd><%= Number(kontingent).toLocaleString('de-DE',{minimumFractionDigits:2}) %> h</dd></div>
    <div><dt>Ist-Leistung</dt><dd><%= Number(ist).toLocaleString('de-DE',{minimumFractionDigits:2}) %> h</dd></div>
    <div><dt>Erstellt am</dt><dd><%= new Date().toLocaleDateString('de-DE') %></dd></div>
  </div>

  <div class="parteien">
    <div><div class="k">Leistungserbringer</div>
      <b>STEER.E · <%= e.firma_name %></b><br><%= e.firma_adresse %><br><%= e.firma_register %></div>
    <div><div class="k">Leistungsempfänger</div>
      <b><%= org.name %></b><br><%= retainer.hinweis || '' %></div>
  </div>

  <h2>Erbrachte Leistungen</h2>
  <table>
    <thead><tr><th style="width:9mm">Pos.</th><th>Leistung</th><th style="width:30mm">Status</th><th style="width:20mm" class="z">Stunden</th></tr></thead>
    <tbody>
    <% leistungen.forEach(function(l, i){ %>
      <tr><td><%= String(i+1).padStart(2,'0') %></td>
        <td><b><%= l.titel %></b><% if (l.beschreibung) { %><br><span style="font-size:8.5pt;color:#555"><%= l.beschreibung %></span><% } %></td>
        <td><%= l.status %></td>
        <td class="z"><%= Number(l.stunden).toLocaleString('de-DE',{minimumFractionDigits:2}) %></td></tr>
    <% }) %>
    <tr class="summe"><td colspan="3">Summe Ist-Leistung</td><td class="z"><%= Number(ist).toLocaleString('de-DE',{minimumFractionDigits:2}) %> h</td></tr>
    </tbody>
  </table>

  <h2>Retainer-Verrechnung</h2>
  <div class="rechnung">
    <div><span>Vereinbartes Kontingent lt. Retainer</span><span><%= Number(kontingent).toLocaleString('de-DE',{minimumFractionDigits:2}) %> h</span></div>
    <div><span>Nachweislich erbrachte Ist-Leistung</span><span><%= Number(ist).toLocaleString('de-DE',{minimumFractionDigits:2}) %> h</span></div>
    <div><span>davon nicht gesondert berechnete Mehrleistung</span><span><%= Number(mehrleistung).toLocaleString('de-DE',{minimumFractionDigits:2}) %> h</span></div>
    <div><span>Abrechnungsrelevante Leistung</span><span><%= Number(abrechenbar).toLocaleString('de-DE',{minimumFractionDigits:2}) %> h</span></div>
    <div><span>Impliziter Stundensatz</span><span><%= impliziterSatz ? impliziterSatz.toLocaleString('de-DE',{minimumFractionDigits:2, maximumFractionDigits:2}) + ' €/h' : '—' %></span></div>
    <div><span>Retainer-Gebühr netto</span><span><%= Number(entgelt).toLocaleString('de-DE',{minimumFractionDigits:2}) %> €</span></div>
    <div><span>zzgl. <%= e.mwst_satz %> % USt.</span><span><%= (Number(entgelt) * Number(e.mwst_satz) / 100).toLocaleString('de-DE',{minimumFractionDigits:2, maximumFractionDigits:2}) %> €</span></div>
    <div class="gesamt"><span>Rechnungsbetrag brutto</span><span><%= (Number(entgelt) * (1 + Number(e.mwst_satz)/100)).toLocaleString('de-DE',{minimumFractionDigits:2, maximumFractionDigits:2}) %> €</span></div>
  </div>
  <p class="hinw">Retainer-Entgelt: monatlich im Voraus, unabhängig vom Abruf. Nicht abgerufene Stunden verfallen zum Monatsende; Mehrleistung begründet keine Nachforderung.</p>

  <div class="unterschrift">
    <div><%= e.firma_name %> — Leistungserbringer</div>
    <div><%= org.name %> — zur Kenntnis / Freigabe</div>
  </div>
</div></body></html>
