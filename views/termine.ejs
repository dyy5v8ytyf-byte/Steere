<%- include('partials/kopf') %>
<div class="seitenkopf"><div><h1>Termine</h1><div class="unter"><%= termine.length %> Termin(e)</div></div></div>
<div class="kasten" style="margin-bottom:18px">
  <b>Kalender</b> lädt eine Datei herunter — beim Öffnen trägt Outlook den Termin in Ihren eigenen Kalender ein.
  <b>Einladung</b> erzeugt dieselbe Datei als Terminanfrage an den Kunden; Outlook öffnet sie zum Versenden.
  <b>Mail</b> öffnet Outlook mit fertigem Empfänger, Betreff und Text.
  Die Anwendung verschickt dabei nichts von sich aus — abgeschickt wird ausschließlich in Outlook.
  <% if (m365Verbunden) { %><br><b>In Outlook</b> schreibt den Termin dagegen unmittelbar in Ihren Kalender,
  ohne Datei und ohne Umweg — Ihre Microsoft-Verbindung steht.<% } %>
</div>
<div class="karte">
  <% if (!termine.length) { %><div class="leer-hinweis">Keine Termine erfasst.</div><% } else { %>
  <div class="tab-scroll"><table>
    <thead><tr><th>Datum</th><th>Kunde</th><th>Projekt</th><th>Typ</th><th>Mit wem</th><th>Thema</th><th>Bestätigt</th><th>Status</th><th>Info an Kunden</th><th></th></tr></thead>
    <tbody><% termine.forEach(function(t){ %>
      <tr>
        <td><%= datum(t.datum) %><% if (t.uhrzeit) { %><br><span style="font-size:12px;color:var(--ink3)"><%= t.uhrzeit %></span><% } %></td>
        <td><a href="/kunden/<%= t.kunde_id %>"><%= t.firma %></a></td>
        <td><%= t.bezeichnung || '—' %></td>
        <td><span class="pille"><%= t.typ %></span></td>
        <td><%= t.mit_wem || '—' %></td>
        <td><%= t.thema || '—' %><% if (t.ergebnis) { %><br><span style="font-size:12px;color:var(--ink3)"><%= t.ergebnis %></span><% } %></td>
        <td><span class="pille <%= t.bestaetigt === 'ja' ? 'ok' : t.bestaetigt === 'nein' ? 'rot' : '' %>"><%= t.bestaetigt %></span></td>
        <td><%= t.status %></td>
        <td><%= t.kunde_informiert ? 'ja' : (t.typ !== 'Kunde' && t.bestaetigt === 'ja' ? 'offen' : '—') %></td>
        <td class="z">
          <div class="reihe" style="gap:5px;justify-content:flex-end;margin-bottom:5px">
            <% if (t.datum) { %>
              <a class="knopf leer mini" href="/termine/<%= t.id %>/kalender.ics"
                 title="Kalenderdatei herunterladen — Outlook trägt den Termin beim Öffnen ein">Kalender</a>
              <% if (t.kunde_email) { %>
                <a class="knopf leer mini" href="/termine/<%= t.id %>/kalender.ics?einladung=1"
                   title="Als Terminanfrage an <%= t.kunde_email %> — in Outlook öffnen und versenden">Einladung</a>
              <% } %>
            <% } %>
            <% if (m365Verbunden && t.datum) { %>
              <form method="post" action="/m365/termin/<%= t.id %>" style="display:inline">
                <button class="knopf mini" type="submit"
                        title="Direkt in Ihren Outlook-Kalender schreiben"><%= t.m365_ereignis_id ? 'Outlook ↻' : 'In Outlook' %></button>
              </form>
              <% if (t.kunde_email) { %>
                <form method="post" action="/m365/termin/<%= t.id %>" style="display:inline">
                  <input type="hidden" name="einladen" value="1">
                  <button class="knopf leer mini" type="submit"
                          title="Termin anlegen und Einladung an <%= t.kunde_email %> senden">+ einladen</button>
                </form>
              <% } %>
            <% } %>
            <% if (t.mailto) { %>
              <a class="knopf leer mini" href="<%= t.mailto %>"
                 title="Outlook mit vorbereiteter Mail an <%= t.kunde_email %> öffnen">Mail</a>
            <% } %>
          </div>
          <details class="block" style="margin:0;border:none;background:none">
            <summary style="padding:4px 0">bearbeiten</summary>
            <div class="inhalt" style="padding:10px 0 0;min-width:240px">
              <form method="post" action="/termine/<%= t.id %>">
                <div class="feld"><label>Status</label><select name="status"><% ['geplant','durchgeführt','verschoben','abgesagt'].forEach(function(s){ %><option <%= t.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
                <div class="feld"><label>Bestätigt</label><select name="bestaetigt"><% ['offen','ja','nein'].forEach(function(s){ %><option <%= t.bestaetigt === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
                <div class="feld"><label>Ergebnis</label><textarea name="ergebnis" style="min-height:60px"><%= t.ergebnis || '' %></textarea></div>
                <div class="haken"><input type="checkbox" id="ki<%= t.id %>" name="kunde_informiert" <%= t.kunde_informiert ? 'checked' : '' %>><label for="ki<%= t.id %>">Kunde informiert</label></div>
                <div class="feld"><label>Wie informiert</label><select name="kunde_informiert_methode"><option value="">—</option><% ['Telefon','E-Mail','Persönlich','Sonstiges'].forEach(function(s){ %><option <%= t.kunde_informiert_methode === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
                <input type="hidden" name="typ" value="<%= t.typ %>">
                <input type="hidden" name="mit_wem" value="<%= t.mit_wem || '' %>">
                <input type="hidden" name="datum" value="<%= fuerFeld(t.datum) %>">
                <input type="hidden" name="uhrzeit" value="<%= t.uhrzeit || '' %>">
                <input type="hidden" name="ort" value="<%= t.ort || '' %>">
                <input type="hidden" name="thema" value="<%= t.thema || '' %>">
                <button class="knopf mini" type="submit">Speichern</button>
              </form>
            </div>
          </details>
        </td>
      </tr>
    <% }) %></tbody></table></div>
  <% } %>
</div>
<%- include('partials/fuss') %>
