<%- include('partials/kopf') %>
<div class="seitenkopf"><div><h1>Änderungsprotokoll</h1>
  <div class="unter"><%= gesamt.toLocaleString('de-DE') %> Einträge · wird nie geleert</div></div>
  <a class="knopf leer" href="/verwaltung">Zurück</a></div>
<div class="karte">
  <div class="tab-scroll"><table>
    <thead><tr><th>Zeitpunkt</th><th>Wer</th><th>Aktion</th><th>Objekt</th><th>Details</th></tr></thead>
    <tbody><% eintraege.forEach(function(p){ %>
      <tr><td style="white-space:nowrap"><%= datumZeit(p.zeitpunkt) %></td>
        <td><%= p.benutzer_txt || '—' %></td>
        <td><span class="pille"><%= p.aktion %></span></td>
        <td><%= p.objekt || '—' %><%= p.objekt_id ? ' #' + p.objekt_id : '' %></td>
        <td style="font-size:12px;color:var(--ink3);max-width:420px;word-break:break-word"><%= p.details ? JSON.stringify(p.details) : '' %></td></tr>
    <% }) %></tbody></table></div>
  <% if (seiten > 1) { %>
    <div class="reihe" style="margin-top:16px;justify-content:center">
      <% if (seite > 1) { %><a class="knopf leer mini" href="?seite=<%= seite-1 %>">← zurück</a><% } %>
      <span style="font-size:13px;color:var(--ink3)">Seite <%= seite %> von <%= seiten %></span>
      <% if (seite < seiten) { %><a class="knopf leer mini" href="?seite=<%= seite+1 %>">weiter →</a><% } %>
    </div>
  <% } %>
</div>
<%- include('partials/fuss') %>
